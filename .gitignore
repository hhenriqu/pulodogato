# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# HMO-132. Saiu do versionamento: a fonte da verdade das variaveis de producao
# e Project Settings → Environment Variables na Vercel, e um arquivo com os
# valores de producao no repo e um pe-de-cabra local -- `next build` num clone
# sem .env.local liga a maquina de qualquer um no banco real, sem avisar.
# Continua existindo na maquina de quem ja tem (o `git rm` foi --cached).
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA files
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/sw.js.map
/public/workbox-*.js.map
/public/worker-*.js.map

